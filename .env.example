# ============================================================
# cloud-clove — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Better Auth ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ─── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Google OAuth ───────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Pinata (IPFS Storage) ──────────────────────────────────
# Dashboard: https://app.pinata.cloud
PINATA_JWT=your_pinata_jwt_here
NEXT_PUBLIC_GATEWAY_URL=your_pinata_gateway_url_here

# ─── Cron / Keep-Alive (Optional) ───────────────────────────
# Generate with: openssl rand -hex 32
# When set on Vercel, scheduled GET requests must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
